{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "repos,pull_requests"
      }
    },
    "circulation": {
      "command": "python",
      "args": ["circulation_server.py"]
    }
  }
}
